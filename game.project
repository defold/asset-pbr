[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[display]
width = 960
height = 640
high_dpi = 1
samples = 4

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01

[html5]
scale_mode = stretch

[project]
title = template-pbr
dependencies#0 = https://github.com/Jhonnyg/defold-vantage/archive/refs/heads/master.zip

[light]
max_count = 8

[render]
clear_color_red = 0.0
clear_color_green = 0.011719
clear_color_blue = 0.050781

[library]
include_dirs = defold-pbr
defold_min_version = 1.13.1

[input]
game_binding = /vantage/vantage.input_bindingc

