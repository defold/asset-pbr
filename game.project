[bootstrap]
main_collection = /main/main.collectionc

[script]
shared_state = 1

[display]
width = 960
height = 640
high_dpi = 1

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01

[html5]
scale_mode = stretch

[project]
title = template-pbr

[light]
max_count = 8

[render]
clear_color_red = 0.25
clear_color_green = 0.25
clear_color_blue = 0.25

